# Autologin X session for tv on tty1 (replaces a display manager). Install as a
# COPY in /etc/systemd/system (setup.sh does): SELinux rejects user_home_t units.
[Unit]
Description=tiny-media-center X session (tv on tty1)
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service dbus.socket
Wants=dbus.socket

[Service]
User=tv
WorkingDirectory=~
PAMName=login
EnvironmentFile=-/etc/locale.conf
Environment=XDG_SESSION_TYPE=x11
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Via `bash start-x`, not startx: startx is initrc_exec_t, which would run the
# session as initrc_t (no user namespaces for Steam/Flatpak); bash keeps unconfined_t.
ExecStart=/usr/bin/bash /home/tv/ghq/github.com/JanPokorny/tiny-media-center/session/start-x
# pam_systemd puts the session in its own scope, out of reach of KillMode.
ExecStop=/usr/bin/pkill -TERM -P $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
Alias=display-manager.service
